        </div>

        <p class="elsora-cart-reassure">
          <span>Free storage case included</span><span class="elsora-cart-reassure__dot" aria-hidden="true">&middot;</span><span>Free U.S. shipping</span><span class="elsora-cart-reassure__dot" aria-hidden="true">&middot;</span><span>30-day money-back guarantee</span>
        </p>

        <!-- CTAs -->

        <div class="cart__ctas" {{ block.shopify_attributes }}>
          <button
            type="submit"
            id="CartDrawer-Checkout"
            class="cart__checkout-button button"
            name="checkout"
            form="CartDrawer-Form"
            {% if cart == empty %}
              disabled
            {% endif %}
          >
            {{ 'sections.cart.checkout' | t }}
          </button>
        </div>
        <a href="{{ routes.cart_url }}" class="elsora-drawer__view-cart">View full cart</a>
      </div>
    </div>
  </div>
</cart-drawer>

{%- comment -%}
  ELSORA cart drawer styles. The drawer is used on every page, so colours and
  fonts are set here directly (same values as the ice-globes tokens and the
  /cart page in sections/main-cart-items.liquid), not through page tokens.
{%- endcomment -%}
<style>
  .elsora-drawer {
    --ed-ink: #0D0D0D;
    --ed-soft: #3E4C5C;
    --ed-cta: #706FCB;
    --ed-cta-hover: #5F5EBB;
    --ed-line: rgba(23, 35, 51, 0.10);
    --ed-radius: 14px;
    --ed-font: "Helvetica Neue", Helvetica, Arial, sans-serif;
    --ed-shadow: 0 10px 20px -10px rgba(46, 32, 36, 0.10), 0 22px 40px -16px rgba(46, 32, 36, 0.12);
  }
  .elsora-drawer .drawer__inner {
    --font-body-family: var(--ed-font);
    --font-heading-family: var(--ed-font);
    --color-foreground: 13,13,13;
    background: linear-gradient(180deg, #FFFFFF 0%, #F0F8F8 22%, #D8F4F8 62%, #C4EEF6 100%);
    border: none;
    box-shadow: -18px 0 40px -20px rgba(13, 13, 13, 0.25);
    padding: 0 2rem;
    font-family: var(--ed-font);
    font-weight: 300;
    color: var(--ed-ink);
  }
  .elsora-drawer.is-empty .drawer__inner {
    padding: 0;
  }
  .elsora-drawer .drawer__inner-empty {
    padding: 0 2rem;
  }

  /* ---- Header ---- */
  .elsora-drawer .drawer__header {
    padding: 2.2rem 0 1.4rem;
  }
  .elsora-drawer .drawer__heading {
    font-family: var(--ed-font);
    font-weight: 500;
