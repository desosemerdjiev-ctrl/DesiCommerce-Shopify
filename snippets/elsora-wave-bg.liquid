<style>
  .elsora-wave-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    background: #FFFFFF;
    background: var(--elsora-finish-wave, none), linear-gradient(
      180deg,
      #FFFFFF 0%, #F8F8F8 5%, #F0F8F8 10%, #D0F0F8 18%, #A8F0F8 28%,
      #78E8F0 42%, #58E8F0 55%, #70E8F0 68%, #A0F0F8 80%, #D8F8F8 91%, #FFFFFF 100%
    );
    background-size: var(--elsora-finish-wave-size, auto);
    background-repeat: var(--elsora-finish-wave-repeat, repeat);
    background-blend-mode: var(--elsora-finish-wave-blend, normal);
  }
  .elsora-wave-bg__top-fade {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 220px;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(255,255,255,0.92) 0%, rgba(255,255,255,0.55) 45%, rgba(255,255,255,0) 100%);
  }
  .elsora-wave-bg__wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    mask-image: linear-gradient(180deg, transparent 0%, black 15%, black 60%, transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, black 15%, black 60%, transparent 100%);
  }
  .elsora-wave-bg__lines--desktop,
  .elsora-wave-bg__lines--mobile {
    width: 100%;
    height: 100%;
    display: none;
  }
  .elsora-wave-bg__lines--desktop {
    display: block;
  }
  @media (max-width: 900px) {
    .elsora-wave-bg__lines--desktop {
      display: none;
    }
    .elsora-wave-bg__lines--mobile {
      display: block;
    }
  }
</style>
