{% style %}
  :root {
    --elsora-font-display: "Helvetica Neue", Helvetica, Arial, sans-serif;
    --elsora-font-body: "Helvetica Neue", Helvetica, Arial, sans-serif;

    --elsora-cream: {{ px_cream }};
    --elsora-cream-deep: {{ px_cream_deep }};
    --elsora-plum: {{ px_plum }};
    --elsora-plum-soft: {{ px_plum_soft }};
    --elsora-rose: {{ px_rose }};
    --elsora-rose-deep: {{ px_rose_deep }};
    --elsora-gold: {{ px_gold }};
    --elsora-sage: {{ px_sage }};
    --elsora-line: {{ px_line }};
    --elsora-tint: {{ px_tint }};
    --elsora-tint-alt: {{ px_tint_alt }};
    --elsora-accent: {{ px_accent }};
    --elsora-cta: {{ px_cta }};

    --elsora-difference-tint: {{ px_difference_tint }};
    --elsora-bridge-accent: {{ px_bridge_accent }};
    --elsora-bridge-accent-deep: {{ px_bridge_accent_deep }};
    --elsora-surface-white: {{ px_surface_white }};
    --elsora-label-ink: {{ px_label_ink }};

    --elsora-footer-grad-1: {{ px_footer_grad_1 }};
    --elsora-footer-grad-2: {{ px_footer_grad_2 }};
    --elsora-footer-grad-3: {{ px_footer_grad_3 }};
    --elsora-footer-accent: {{ px_footer_accent }};

    --elsora-wave-1: {{ px_wave_1 }};
    --elsora-wave-2: {{ px_wave_2 }};
    --elsora-wave-3: {{ px_wave_3 }};

    --elsora-radius: {{ px_radius }};
    --elsora-container-max: 1180px;

    --elsora-shadow-soft: 0 10px 20px -10px rgba(46, 32, 36, 0.10), 0 22px 40px -16px rgba(46, 32, 36, 0.12);
    --elsora-shadow-image: 0 12px 24px -8px rgba(46, 32, 36, 0.20), 0 32px 56px -16px rgba(46, 32, 36, 0.26), 0 56px 84px -26px rgba(46, 32, 36, 0.22);
    --elsora-shadow-image-hover: 0 14px 28px -8px rgba(46, 32, 36, 0.24), 0 38px 64px -14px rgba(46, 32, 36, 0.32), 0 64px 96px -24px rgba(46, 32, 36, 0.28);

    --elsora-text-shadow-3d: 0 2px 3px rgba(13, 13, 13, 0.14), 0 8px 16px rgba(46, 32, 36, 0.22);
    --elsora-text-shadow-3d-sm: 0 3px 6px rgba(46, 32, 36, 0.22);
    --elsora-text-shadow-3d-footer: 0 2px 3px rgba(13, 13, 13, 0.24), 0 6px 12px rgba(13, 13, 13, 0.28);
  }

  {% if elsora_active_palette == 'ice-globes' %}
  /* ---- Heading shadow (sandbox only): hero title + price, section headings, footer newsletter heading ---- */
  [id$="__hero_banner_sandbox"] h1,
  [id$="__lifestyle_row_sandbox"] h2,
  [id$="__difference_grid_sandbox"] h2,
  [id$="__how_to_steps_sandbox"] h2,
  [id$="__reviews_grid_sandbox"] h2,
  [id$="__faq_accordion_sandbox"] h2 {
    text-shadow: var(--elsora-text-shadow-3d);
  }
  [id$="__hero_banner_sandbox"] [class*="cv-price-now-"] {
    text-shadow: var(--elsora-text-shadow-3d-sm);
  }
  .footer-block__newsletter .footer-block__heading {
    text-shadow: var(--elsora-text-shadow-3d-footer);
  }
  {% endif %}
{% endstyle %}
