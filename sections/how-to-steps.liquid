  <div class="cv-howto__head-{{ sid }}">
    {% if section.settings.label != blank %}
      <div class="cv-section-label-{{ sid }}">{{ section.settings.label }}</div>
    {% endif %}
    <h2>{{ section.settings.headline }}</h2>
  </div>
  <div class="cv-steps-{{ sid }}">
    {% for block in section.blocks %}
      <div class="cv-step-{{ sid }}" {{ block.shopify_attributes }}>
        {% if block.settings.image %}
          <img src="{{ block.settings.image | image_url: width: 600 }}"
               alt="{{ block.settings.title | escape }}"
               loading="lazy"
               width="{{ block.settings.image.width }}"
               height="{{ block.settings.image.height }}">
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'cv-step__placeholder-' | append: sid }}
        {% endif %}
        <div class="cv-step__num-{{ sid }}">{{ forloop.index }}</div>
        <h4>{{ block.settings.title }}</h4>
      </div>
    {% endfor %}
  </div>
</div>

{% style %}
  .cv-howto-{{ sid }} {
    --cv-plum: var(--elsora-plum);
    --cv-plum-soft: var(--elsora-plum-soft);
    --cv-rose-deep: var(--elsora-rose-deep);
    --cv-radius: var(--elsora-radius);

    max-width: var(--elsora-container-max);
    margin: 0 auto;
    padding: 64px 32px;
    font-family: var(--elsora-font-body);
    color: var(--cv-plum);
    box-sizing: border-box;
  }
  .cv-howto-{{ sid }} *, .cv-howto-{{ sid }} *::before, .cv-howto-{{ sid }} *::after { box-sizing: border-box; }
  .cv-howto-{{ sid }} img { max-width: 100%; display: block; }

  @media (max-width: 760px) { .cv-howto-{{ sid }} { padding: 48px 20px; } }

  {%- if is_pdrn_sandbox -%}
    .shopify-section:has(.cv-howto-{{ sid }}) {
      background: #FFFFFF;
      background: var(--elsora-finish-wave, none), linear-gradient(
        180deg,
        #FFFFFF 0%, #F8F8F8 5%, #F0F8F8 10%, #D0F0F8 18%, #A8F0F8 28%,
        #78E8F0 42%, #58E8F0 55%, #70E8F0 68%, #A0F0F8 80%, #D8F8F8 91%, #FFFFFF 100%
      );
      background-size: var(--elsora-finish-wave-size, auto);
      background-repeat: var(--elsora-finish-wave-repeat, repeat);
      background-blend-mode: var(--elsora-finish-wave-blend, normal);
    }
    .cv-howto-{{ sid }} {
      position: relative;
    }
    .cv-howto-wave-wrap-{{ sid }} {
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 100vw;
      height: 100%;
      z-index: 0;
      pointer-events: none;
      overflow: hidden;
      mask-image: linear-gradient(180deg, transparent 0%, black 15%, black 85%, transparent 100%);
      -webkit-mask-image: linear-gradient(180deg, transparent 0%, black 15%, black 85%, transparent 100%);
    }
    .cv-howto-wave-lines--desktop-{{ sid }},
    .cv-howto-wave-lines--mobile-{{ sid }} {
      width: 100%;
      height: 100%;
      display: none;
    }
    .cv-howto-wave-lines--desktop-{{ sid }} {
      display: block;
    }
    @media (max-width: 900px) {
      .cv-howto-wave-lines--desktop-{{ sid }} {
        display: none;
      }
      .cv-howto-wave-lines--mobile-{{ sid }} {
        display: block;
      }
    }
    .cv-howto__head-{{ sid }},
    .cv-steps-{{ sid }} {
      position: relative;
      z-index: 1;
    }
  {%- endif -%}

  .cv-howto__head-{{ sid }} { text-align: center; max-width: 600px; margin: 0 auto 56px; }
  .cv-howto__head-{{ sid }} .cv-section-label-{{ sid }} {
    font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: #706FCB; margin-bottom: 14px;
  }
  .cv-howto__head-{{ sid }} h2 {
    font-family: var(--elsora-font-display); font-size: clamp(28px, 3.4vw, 42px); font-weight: 400; margin: 0;
    color: var(--cv-plum);
  }

  .cv-steps-{{ sid }} { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  @media (max-width: 760px) { .cv-steps-{{ sid }} { grid-template-columns: repeat(2, 1fr); } }

  .cv-step-{{ sid }} img {
    border-radius: var(--cv-radius); aspect-ratio: 3 / 4; object-fit: cover; object-position: center 20%; margin: 0 auto 16px; width: 72%; display: block;
    box-shadow: var(--elsora-shadow-image);
    transition: transform .4s cubic-bezier(.22,1,.36,1), box-shadow .4s cubic-bezier(.22,1,.36,1);
  }
  .cv-step-{{ sid }} img:hover {
    transform: translateY(-6px);
    box-shadow: var(--elsora-shadow-image-hover);
  }

  .cv-step__num-{{ sid }} {
    display: block;
    text-align: center;
    font-family: var(--elsora-font-body);
    font-style: normal;
    color: #0D0D0D;
    font-weight: 400;
    opacity: 0.75;
    font-size: 12px;
    letter-spacing: 0.08em;
    margin: 10px 0 8px;
  }
  .cv-step-{{ sid }} h4 {
  font-family: var(--elsora-font-body);
  font-size: 14.5px;
  font-weight: 400;
  margin: 0;
  text-align: center;
  color: #0D0D0D;
}

  @media (max-width: 760px) {
    .cv-steps-{{ sid }} { gap: 16px; }
    .cv-step-{{ sid }} img { width: 88%; }
    .cv-step__num-{{ sid }} { color: #0D0D0D; }
  }
{% endstyle %}

{% schema %}
{
  "name": "CV How-To Steps",
  "settings": [
    { "type": "text", "id": "label", "label": "Eyebrow label", "default": "Usage tips" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "How to get smooth" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Step image" },
        { "type": "text", "id": "title", "label": "Step title" }
      ]
    }
  ],
  "presets": [
    {
      "name": "CV How-To Steps",
      "blocks": [
        { "type": "step", "settings": { "title": "Cleanse & dry skin" } },
        { "type": "step", "settings": { "title": "Spray evenly on the area" } },
        { "type": "step", "settings": { "title": "Wait 5–10 minutes" } },
        { "type": "step", "settings": { "title": "Wipe away & rinse" } }
      ]
    }
  ]
}
{% endschema %}