{% assign sid = section.id %}
{% assign product = section.settings.product | default: product %}
{%- assign is_pdrn_sandbox = false -%}
{%- if template.suffix == 'pdrn-sandbox' or template.suffix == 'ice-globes' or template.name == 'index' -%}
  {%- assign is_pdrn_sandbox = true -%}
{%- endif -%}

{% comment %}
  6 curated lifestyle photos, uploaded as full-resolution originals to
  Shopify Files (Admin -> Content -> Files) and referenced here via
  image_picker settings, rendered through Shopify's CDN with a responsive
  srcset — not hardcoded/base64 theme assets, so real sharp originals are
  served at the size each device actually needs.
{% endcomment %}

<div class="cv-reviews-{{ sid }}" id="reviews">
  <div class="cv-reviews__head-{{ sid }}">
    <div class="cv-reviews__title-{{ sid }}">
      <h2>{{ section.settings.headline }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="cv-reviews__note-{{ sid }}">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
    <div class="cv-guarantee-badge-{{ sid }}">
      <div class="cv-guarantee-title-{{ sid }}">{{ section.settings.guarantee_title }}</div>
      <div class="cv-guarantee-subtext-{{ sid }}">{{ section.settings.guarantee_subtext }}</div>
    </div>
  </div>

  {% comment %}
    Real Loox reviews, rendered client-side from the Storefront API (public
    store id, no secret key) — see snippets/loox-reviews-script.liquid.
    Hidden by default; only unhidden by that script when 1+ published
    reviews exist, so 0 reviews means no empty space and no markup left
    behind. Placed above the 6 lifestyle cards per spec.
  {% endcomment %}
  <div class="cv-loox-grid" id="cv-loox-cards" hidden></div>
  {% render 'loox-reviews-script', product: product %}

  <div class="cv-lifestyle-grid-{{ sid }}">
    <div class="cv-lifestyle-card-{{ sid }}">
      {% if section.settings.image_1 %}
        <img
          src="{{ section.settings.image_1 | image_url: width: 800 }}"
          srcset="{{ section.settings.image_1 | image_url: width: 400 }} 400w, {{ section.settings.image_1 | image_url: width: 800 }} 800w, {{ section.settings.image_1 | image_url: width: 1200 }} 1200w, {{ section.settings.image_1 | image_url: width: 1600 }} 1600w"
          sizes="(max-width: 900px) 82vw, 400px"
          alt="{{ section.settings.caption_1 | escape }}"
          loading="lazy"
          width="{{ section.settings.image_1.width }}"
          height="{{ section.settings.image_1.height }}">
      {% endif %}
      <div class="cv-lifestyle-caption-{{ sid }}">{{ section.settings.caption_1 }}</div>
    </div>
    <div class="cv-lifestyle-card-{{ sid }}">
      {% if section.settings.image_2 %}
        <img
          src="{{ section.settings.image_2 | image_url: width: 800 }}"
          srcset="{{ section.settings.image_2 | image_url: width: 400 }} 400w, {{ section.settings.image_2 | image_url: width: 800 }} 800w, {{ section.settings.image_2 | image_url: width: 1200 }} 1200w, {{ section.settings.image_2 | image_url: width: 1600 }} 1600w"
          sizes="(max-width: 900px) 82vw, 400px"
          alt="{{ section.settings.caption_2 | escape }}"
          loading="lazy"
          width="{{ section.settings.image_2.width }}"
          height="{{ section.settings.image_2.height }}">
      {% endif %}
      <div class="cv-lifestyle-caption-{{ sid }}">{{ section.settings.caption_2 }}</div>
    </div>
    <div class="cv-lifestyle-card-{{ sid }}">
      {% if section.settings.image_3 %}
        <img
          src="{{ section.settings.image_3 | image_url: width: 800 }}"
          srcset="{{ section.settings.image_3 | image_url: width: 400 }} 400w, {{ section.settings.image_3 | image_url: width: 800 }} 800w, {{ section.settings.image_3 | image_url: width: 1200 }} 1200w, {{ section.settings.image_3 | image_url: width: 1600 }} 1600w"
          sizes="(max-width: 900px) 82vw, 400px"
          alt="{{ section.settings.caption_3 | escape }}"
          loading="lazy"
          width="{{ section.settings.image_3.width }}"
          height="{{ section.settings.image_3.height }}">
      {% endif %}
      <div class="cv-lifestyle-caption-{{ sid }}">{{ section.settings.caption_3 }}</div>
    </div>
    <div class="cv-lifestyle-card-{{ sid }}">
      {% if section.settings.image_4 %}
        <img
          src="{{ section.settings.image_4 | image_url: width: 800 }}"
          srcset="{{ section.settings.image_4 | image_url: width: 400 }} 400w, {{ section.settings.image_4 | image_url: width: 800 }} 800w, {{ section.settings.image_4 | image_url: width: 1200 }} 1200w, {{ section.settings.image_4 | image_url: width: 1600 }} 1600w"
          sizes="(max-width: 900px) 82vw, 400px"
          alt="{{ section.settings.caption_4 | escape }}"
          loading="lazy"
          width="{{ section.settings.image_4.width }}"
          height="{{ section.settings.image_4.height }}">
      {% endif %}
      <div class="cv-lifestyle-caption-{{ sid }}">{{ section.settings.caption_4 }}</div>
    </div>
    <div class="cv-lifestyle-card-{{ sid }}">
      {% if section.settings.image_5 %}
        <img
          src="{{ section.settings.image_5 | image_url: width: 800 }}"
          srcset="{{ section.settings.image_5 | image_url: width: 400 }} 400w, {{ section.settings.image_5 | image_url: width: 800 }} 800w, {{ section.settings.image_5 | image_url: width: 1200 }} 1200w, {{ section.settings.image_5 | image_url: width: 1600 }} 1600w"
          sizes="(max-width: 900px) 82vw, 400px"
          alt="{{ section.settings.caption_5 | escape }}"
          loading="lazy"
          width="{{ section.settings.image_5.width }}"
          height="{{ section.settings.image_5.height }}">
      {% endif %}
      <div class="cv-lifestyle-caption-{{ sid }}">{{ section.settings.caption_5 }}</div>
    </div>
    <div class="cv-lifestyle-card-{{ sid }}">
      {% if section.settings.image_6 %}
        <img
          src="{{ section.settings.image_6 | image_url: width: 800 }}"
          srcset="{{ section.settings.image_6 | image_url: width: 400 }} 400w, {{ section.settings.image_6 | image_url: width: 800 }} 800w, {{ section.settings.image_6 | image_url: width: 1200 }} 1200w, {{ section.settings.image_6 | image_url: width: 1600 }} 1600w"
          sizes="(max-width: 900px) 82vw, 400px"
          alt="{{ section.settings.caption_6 | escape }}"
          loading="lazy"
          width="{{ section.settings.image_6.width }}"
          height="{{ section.settings.image_6.height }}">
      {% endif %}
      <div class="cv-lifestyle-caption-{{ sid }}">{{ section.settings.caption_6 }}</div>
    </div>
  </div>

  <div class="cv-promise-row-{{ sid }}">
    <div class="cv-promise-card-{{ sid }}">
      <span class="cv-promise-icon-{{ sid }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8l9-4 9 4-9 4-9-4z"/><path d="M3 8v8l9 4 9-4V8"/><path d="M12 12v8"/></svg>
      </span>
      <div class="cv-promise-title-{{ sid }}">{{ section.settings.promise_title_1 }}</div>
      <div class="cv-promise-text-{{ sid }}">{{ section.settings.promise_text_1 }}</div>
    </div>
    <div class="cv-promise-card-{{ sid }}">
      <span class="cv-promise-icon-{{ sid }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="M4.5 6.5l15 11"/><path d="M19.5 6.5l-15 11"/><path d="M9.5 4.2l2.5 2.3 2.5-2.3"/><path d="M9.5 19.8l2.5-2.3 2.5 2.3"/><path d="M4.9 9l3 .3.3-3"/><path d="M19.1 15l-3-.3-.3 3"/><path d="M19.1 9l-3 .3-.3-3"/><path d="M4.9 15l3-.3.3 3"/></svg>
      </span>
      <div class="cv-promise-title-{{ sid }}">{{ section.settings.promise_title_2 }}</div>
      <div class="cv-promise-text-{{ sid }}">{{ section.settings.promise_text_2 }}</div>
    </div>
    <div class="cv-promise-card-{{ sid }}">
      <span class="cv-promise-icon-{{ sid }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h13v8H3z"/><path d="M16 10.5h2a1 1 0 0 1 1 1v1a1 1 0 0 1-1 1h-2"/><path d="M4 4l16 16"/></svg>
      </span>
      <div class="cv-promise-title-{{ sid }}">{{ section.settings.promise_title_3 }}</div>
      <div class="cv-promise-text-{{ sid }}">{{ section.settings.promise_text_3 }}</div>
    </div>
  </div>

  {% if section.settings.bottom_line != blank %}
    <div class="cv-reviews__footer-line-{{ sid }}" id="cv-loox-new-brand-line">{{ section.settings.bottom_line }}</div>
  {% endif %}
  {% if section.settings.review_promise_line != blank %}
    <div class="cv-reviews__footer-line-{{ sid }}">{{ section.settings.review_promise_line }}</div>
  {% endif %}
</div>

{% style %}
  .cv-reviews-{{ sid }} {
    --cv-cream: var(--elsora-cream);
    --cv-cream-deep: var(--elsora-cream-deep);
    --cv-plum: var(--elsora-plum);
    --cv-plum-soft: var(--elsora-plum-soft);
    --cv-rose: var(--elsora-rose);
    --cv-gold: var(--elsora-gold);
    --cv-sage: var(--elsora-sage);
    --cv-radius: var(--elsora-radius);

    background: #C7EFE0;
    padding: 64px 0;
    font-family: var(--elsora-font-body);
    color: var(--cv-plum);
  }
  .cv-reviews-{{ sid }} *, .cv-reviews-{{ sid }} *::before, .cv-reviews-{{ sid }} *::after { box-sizing: border-box; }

  .cv-reviews__head-{{ sid }} {
    max-width: var(--elsora-container-max); margin: 0 auto; padding: 0 32px 40px;
    display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 20px;
  }
  .cv-reviews__head-{{ sid }} h2 {
    font-family: var(--elsora-font-display); font-size: clamp(28px, 3.4vw, 40px); font-weight: 400; margin: 0;
    color: var(--cv-plum);
  }
  .cv-reviews__note-{{ sid }} {
    margin: 8px 0 0; font-family: var(--elsora-font-body); font-size: 15px; font-weight: 400;
    letter-spacing: .02em; color: var(--cv-plum);
  }
  .cv-guarantee-badge-{{ sid }} { text-align: right; }
  .cv-guarantee-title-{{ sid }} {
    font-family: var(--elsora-font-display); font-size: 16px; font-weight: 500; color: var(--cv-plum);
  }
  .cv-guarantee-subtext-{{ sid }} {
    font-size: 12.5px; color: var(--cv-plum-soft); margin-top: 2px;
  }
  @media (max-width: 900px) {
    .cv-guarantee-badge-{{ sid }} { text-align: left; }
  }

  .cv-lifestyle-grid-{{ sid }} {
    max-width: var(--elsora-container-max);
    margin: 0 auto;
    padding: 0 32px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .cv-lifestyle-card-{{ sid }} {
    background: #C7EFE0;
    border-radius: var(--cv-radius);
    overflow: hidden;
    box-shadow:
      0 3px 6px -3px rgba(46,32,36,0.10),
      0 9px 16px -8px rgba(46,32,36,0.14),
      0 15px 22px -12px rgba(46,32,36,0.10);
    transition: transform .3s cubic-bezier(.22,1,.36,1), box-shadow .3s cubic-bezier(.22,1,.36,1);
  }
  .cv-lifestyle-card-{{ sid }}:hover {
    transform: translateY(-4px);
    box-shadow:
      0 4px 8px -3px rgba(46,32,36,0.12),
      0 11px 20px -8px rgba(46,32,36,0.18),
      0 18px 26px -11px rgba(46,32,36,0.14);
  }
  .cv-lifestyle-card-{{ sid }} img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .cv-lifestyle-caption-{{ sid }} {
    padding: 14px 16px;
    font-family: var(--elsora-font-display);
    font-size: 14px;
    font-weight: 400;
    color: var(--cv-plum);
  }

  @media (max-width: 900px) {
    .cv-reviews__head-{{ sid }} { padding: 0 20px 32px; flex-direction: column; align-items: flex-start; gap: 8px; }
    .cv-lifestyle-grid-{{ sid }} {
      display: flex;
      grid-template-columns: none;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: 16px;
      padding: 0 20px;
      scrollbar-width: none;
    }
    .cv-lifestyle-grid-{{ sid }}::-webkit-scrollbar { display: none; }
    .cv-lifestyle-card-{{ sid }} {
      flex: 0 0 82%;
      scroll-snap-align: start;
    }
  }

  .cv-loox-grid {
    max-width: var(--elsora-container-max);
    margin: 0 auto 32px;
    padding: 0 32px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .cv-loox-grid[hidden] { display: none !important; }
  .cv-loox-card {
    background: #C7EFE0;
    border-radius: var(--cv-radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow:
      0 3px 6px -3px rgba(46,32,36,0.10),
      0 9px 16px -8px rgba(46,32,36,0.14),
      0 15px 22px -12px rgba(46,32,36,0.10);
    transition: transform .3s cubic-bezier(.22,1,.36,1), box-shadow .3s cubic-bezier(.22,1,.36,1);
  }
  .cv-loox-card:hover {
    transform: translateY(-4px);
    box-shadow:
      0 4px 8px -3px rgba(46,32,36,0.12),
      0 11px 20px -8px rgba(46,32,36,0.18),
      0 18px 26px -11px rgba(46,32,36,0.14);
  }
  .cv-loox-photo {
    position: relative;
    cursor: pointer;
  }
  .cv-loox-photo:focus-visible {
    outline: 2px solid var(--elsora-accent);
    outline-offset: -2px;
  }
  .cv-loox-photo img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .cv-loox-play-icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 28px;
    text-shadow: 0 2px 6px rgba(0,0,0,0.5);
    pointer-events: none;
  }
  .cv-loox-photo-count {
    position: absolute;
    bottom: 8px;
    right: 8px;
    background: rgba(13,13,13,0.65);
    color: #fff;
    font-size: 12px;
    font-family: var(--elsora-font-body);
    padding: 2px 8px;
    border-radius: 999px;
    pointer-events: none;
  }
  .cv-loox-stars {
    padding: 16px 18px 0;
    font-size: 14px;
    letter-spacing: 2px;
    color: var(--cv-gold);
  }
  .cv-loox-body {
    flex: 1;
    margin: 8px 0;
    padding: 0 18px;
    font-family: var(--elsora-font-body);
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--cv-plum);
  }
  .cv-loox-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0 18px 16px;
    font-family: var(--elsora-font-display);
    font-size: 13px;
    font-weight: 500;
    color: var(--cv-plum);
  }
  .cv-loox-verified {
    font-family: var(--elsora-font-body);
    font-size: 11px;
    font-weight: 400;
    color: var(--cv-sage);
    background: rgba(156, 174, 140, 0.16);
    padding: 2px 8px;
    border-radius: 999px;
  }
  .cv-loox-disclosure {
    padding: 0 18px 16px;
    margin-top: -6px;
  }
  .cv-loox-disclosure span {
    display: inline-block;
    font-family: var(--elsora-font-body);
    font-size: 11px;
    font-weight: 400;
    line-height: 1.4;
    color: var(--cv-plum-soft);
    background: rgba(156, 174, 140, 0.16);
    padding: 3px 10px;
    border-radius: 12px;
  }
  @media (max-width: 900px) {
    .cv-loox-grid {
      display: flex;
      grid-template-columns: none;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: 16px;
      padding: 0 20px;
      margin-bottom: 24px;
      scrollbar-width: none;
    }
    .cv-loox-grid::-webkit-scrollbar { display: none; }
    .cv-loox-card {
      flex: 0 0 82%;
      scroll-snap-align: start;
    }
  }

  .cv-promise-row-{{ sid }} {
    max-width: var(--elsora-container-max);
    margin: 40px auto 0;
    padding: 0 32px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .cv-promise-card-{{ sid }} {
    background: #DCF3E9;
    border: 1.5px solid #BFE7D8;
    border-radius: var(--cv-radius);
    padding: 20px 18px;
    text-align: center;
    box-shadow: var(--elsora-shadow-soft);
  }
  .cv-promise-icon-{{ sid }} {
    display: inline-flex;
    width: 28px;
    height: 28px;
    color: var(--elsora-accent);
    margin-bottom: 10px;
  }
  .cv-promise-icon-{{ sid }} svg { width: 100%; height: 100%; }
  .cv-promise-title-{{ sid }} {
    font-family: var(--elsora-font-display);
    font-weight: 500;
    font-size: 14.5px;
    color: var(--cv-plum);
    margin-bottom: 4px;
  }
  .cv-promise-text-{{ sid }} {
    font-size: 12.5px;
    color: var(--cv-plum-soft);
    line-height: 1.4;
  }
  @media (max-width: 900px) {
    .cv-promise-row-{{ sid }} { grid-template-columns: 1fr; padding: 0 20px; margin-top: 32px; }
  }

  .cv-reviews__footer-line-{{ sid }} {
    max-width: var(--elsora-container-max);
    margin: 24px auto 0;
    padding: 0 32px;
    text-align: center;
    font-size: 12px;
    color: var(--cv-plum-soft);
    letter-spacing: .02em;
  }
  .cv-reviews__footer-line-{{ sid }}[hidden] { display: none !important; }
  @media (max-width: 900px) {
    .cv-reviews__footer-line-{{ sid }} { padding: 0 20px; }
  }

  {%- if is_pdrn_sandbox -%}
    .cv-reviews-{{ sid }} {
      background: #D0F0F8;
      background: var(--elsora-finish-flat, none), linear-gradient(180deg, #FFFFFF 0%, #D0F0F8 15%, #D0F0F8 85%, #FFFFFF 100%);
      background-size: var(--elsora-finish-flat-size, auto);
      background-repeat: var(--elsora-finish-flat-repeat, repeat);
      background-blend-mode: var(--elsora-finish-flat-blend, normal);
    }
  {%- endif -%}
{% endstyle %}

{% schema %}
{
  "name": "CV Reviews Grid",
  "settings": [
    { "type": "product", "id": "product", "label": "Product (for live Loox reviews)" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Ways to use it" },
    { "type": "text", "id": "subheading", "label": "Small caption under the headline", "default": "Illustrative images." },
    { "type": "text", "id": "guarantee_title", "label": "Top-right badge title", "default": "30-Day Money-Back Guarantee" },
    { "type": "text", "id": "guarantee_subtext", "label": "Top-right badge subtext", "default": "Love it or get a full refund." },
    {
      "type": "header",
      "content": "Lifestyle photos (6, fixed order)"
    },
    { "type": "image_picker", "id": "image_1", "label": "Photo 1" },
    { "type": "text", "id": "caption_1", "label": "Caption 1", "default": "Morning reset" },
    { "type": "image_picker", "id": "image_2", "label": "Photo 2" },
    { "type": "text", "id": "caption_2", "label": "Caption 2", "default": "Straight from the freezer" },
    { "type": "image_picker", "id": "image_3", "label": "Photo 3" },
    { "type": "text", "id": "caption_3", "label": "Caption 3", "default": "A ritual to share" },
    { "type": "image_picker", "id": "image_4", "label": "Photo 4" },
    { "type": "text", "id": "caption_4", "label": "Caption 4", "default": "A moment just for you" },
    { "type": "image_picker", "id": "image_5", "label": "Photo 5" },
    { "type": "text", "id": "caption_5", "label": "Caption 5", "default": "Evening wind-down" },
    { "type": "image_picker", "id": "image_6", "label": "Photo 6" },
    { "type": "text", "id": "caption_6", "label": "Caption 6", "default": "Post-shave cool down" },
    {
      "type": "header",
      "content": "Promise cards"
    },
    { "type": "text", "id": "promise_title_1", "label": "Promise 1 title", "default": "Free Case With Every Order" },
    { "type": "text", "id": "promise_text_1", "label": "Promise 1 text", "default": "Freezer-safe, holds two globes." },
    { "type": "text", "id": "promise_title_2", "label": "Promise 2 title", "default": "Cold or Warm" },
    { "type": "text", "id": "promise_text_2", "label": "Promise 2 text", "default": "One tool, two rituals." },
    { "type": "text", "id": "promise_title_3", "label": "Promise 3 title", "default": "No Batteries, No Charging" },
    { "type": "text", "id": "promise_text_3", "label": "Promise 3 text", "default": "Stainless steel, made to last." },
    { "type": "text", "id": "bottom_line", "label": "Bottom line text (hidden once real reviews exist)", "default": "New from ELSORA — be among the first to share your ritual." },
    { "type": "text", "id": "review_promise_line", "label": "Review promise line", "default": "Our review promise: every review on this page will come from a real customer, collected after delivery. We publish them all — never edited, never hidden." }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "CV Reviews Grid"
    }
  ]
}
{% endschema %}
