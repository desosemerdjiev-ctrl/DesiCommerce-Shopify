{% assign sid = section.id %}
{%- assign is_pdrn_sandbox = false -%}
{%- if template.suffix == 'pdrn-sandbox' or template.suffix == 'ice-globes' or template.name == 'index' -%}
  {%- assign is_pdrn_sandbox = true -%}
{%- endif -%}
{% assign product = section.settings.product | default: product %}
{% assign gallery_images = product.media | where: 'media_type', 'image' %}
{% assign gallery_video = product.media | where: 'media_type', 'video' | first %}
{%- comment -%} ELSORA (round 26): prefer the video whose ID is in the hero gallery order (75631715811653, slide 8). {%- endcomment -%}
{% for cv_v in product.media %}{% if cv_v.media_type == 'video' %}{% assign cv_v_id = cv_v.id | append: '' %}{% if cv_v_id == '75631715811653' %}{% assign gallery_video = cv_v %}{% endif %}{% endif %}{% endfor %}
{% if gallery_video == blank %}
  {% assign gallery_video = product.media | where: 'media_type', 'external_video' | first %}
{% endif %}
{% comment %}
  ELSORA hero gallery. cv_gallery_order is the exact order of the hero images
  (media IDs): morning-ritual, choose-your-pair, perfectly-sized, cold-warm,
  face-to-shoulders, crafted-to-last, everything-you-need. The product's own
  media order is not used for the hero. If none of these IDs is on the product,
  the hero falls back to product media order minus cv_hidden_media: the
  Silver Pair / Premium Gold Pair variant images, the old main image
  (ChatGPTImageSep12_2026_01_35_36PM.png), the silver + gold photo
  (ChatGPT_Image_Sep_12_2026_02_16_06_PM.png), the before/after image and
  the old crafted-to-last image (elsora-gallery-6-crafted-to-last.webp,
  replaced in round 22 by 75415222911301, "Soft silicone grip").
  All of them stay on the product and in Files.
{% endcomment %}
{% assign cv_gallery_order = '75333096014149,75332834951493,75084847055173,75084847087941,75084847120709,75415222911301,75332405625157' | split: ',' %}
{% assign cv_hidden_media = '74677795946821,74677796012357,74886235324741,74859462197573,75085145571653,75084847153477' | split: ',' %}
{% assign cv_product_media_ids = '' %}
{% for cv_m in product.media %}
  {% assign cv_m_id = cv_m.id | append: '' %}
  {% assign cv_product_media_ids = cv_product_media_ids | append: ',' | append: cv_m_id %}
{% endfor %}
{% assign cv_product_media_ids = cv_product_media_ids | split: ',' %}
{% assign cv_gallery_ids = '' %}
{% for cv_id in cv_gallery_order %}
  {% if cv_product_media_ids contains cv_id %}{% assign cv_gallery_ids = cv_gallery_ids | append: ',' | append: cv_id %}{% endif %}
{% endfor %}
{% if cv_gallery_ids == blank %}
  {% for cv_m_id in cv_product_media_ids %}
    {% if cv_m_id != blank %}{% unless cv_hidden_media contains cv_m_id %}{% assign cv_gallery_ids = cv_gallery_ids | append: ',' | append: cv_m_id %}{% endunless %}{% endif %}
  {% endfor %}
{% endif %}
{% assign cv_gallery_ids = cv_gallery_ids | remove_first: ',' | split: ',' %}
{%- comment -%}
  ELSORA (round 32): the product video only renders (main slide + thumbnail)
  when its media ID is in the gallery list above. Video #8 (75631715811653)
  is hidden for now; the video-support code stays, so a 4:5 video can be
  added later by putting its ID back into cv_gallery_order.
{%- endcomment -%}
{% if gallery_video %}{% assign cv_gv_check = gallery_video.id | append: '' %}{% unless cv_gallery_ids contains cv_gv_check %}{% assign gallery_video = nil %}{% endunless %}{% endif %}
{% assign first_media = nil %}
{% for cv_m in product.media %}
  {% assign cv_m_id = cv_m.id | append: '' %}
  {% if cv_m_id == cv_gallery_ids.first %}{% assign first_media = cv_m %}{% break %}{% endif %}
{% endfor %}
{% comment %}
  Ice Globes pair-only offer grid (Silver Pair / Premium Gold Pair): matches real
  Shopify variants by title text ('silver' / 'gold'). Each variant IS a
  pair (1 unit = 1 pair, price taken straight from the variant); there are
  no singles, no compare-at prices and no discounts on this selector.
{% endcomment %}
{% assign cv_silver_variant = nil %}
{% assign cv_gold_variant = nil %}
{% comment %} ELSORA ice globes: match Silver Pair / Premium Gold Pair by variant ID first (names can change); the title match below is the fallback. {% endcomment %}
{% if product %}
  {% for variant in product.variants %}
    {% if variant.id == 59209490235717 %}{% assign cv_silver_variant = variant %}{% elsif variant.id == 59209490268485 %}{% assign cv_gold_variant = variant %}{% endif %}
  {% endfor %}
  {% for variant in product.variants %}
    {% assign cv_vt = variant.title | downcase %}
    {% if cv_vt contains 'silver' and cv_silver_variant == nil %}
      {% assign cv_silver_variant = variant %}
    {% elsif cv_vt contains 'gold' and cv_gold_variant == nil %}
      {% assign cv_gold_variant = variant %}
    {% endif %}
  {% endfor %}
{% endif %}
{% assign cv_has_color_variants = false %}
{% if cv_silver_variant and cv_gold_variant %}
  {% assign cv_has_color_variants = true %}
{% endif %}
{% assign cv_silver_pair_total = cv_silver_variant.price | money %}
{% assign cv_gold_pair_total = cv_gold_variant.price | money %}
{% comment %} ELSORA: the big hero price follows the selected Silver/Gold card (Gold is preselected). {% endcomment %}
{% assign cv_hero_price = product.price %}
{% if cv_has_color_variants %}{% assign cv_hero_price = cv_gold_variant.price %}{% endif %}

{% comment %}
  Background-removed (transparent) versions of the same 4 reference photos,
  generated via deterministic flood-fill from the source images' pure-white
  studio background (not AI) so the metal + white handle render unmodified
  and the product sits directly on the card's mint background, no white box.
  Stored as theme assets (not Shopify Files) since Files API write access is
  not available to this session; served via asset_url, bypassing image_url
  (which expects a Files-hosted image, not a plain theme-asset URL).
{% endcomment %}
{% assign cv_img_silver_pair = section.settings.offer_silver_pair_image %}
{% assign cv_img_silver_pair_is_asset = false %}
{% unless cv_img_silver_pair %}
  {% assign cv_img_silver_pair = 'elsora-ref-silver-pair-transparent.png' | asset_url %}
  {% assign cv_img_silver_pair_is_asset = true %}
{% endunless %}
{% assign cv_img_gold_pair = section.settings.offer_gold_pair_image %}
{% assign cv_img_gold_pair_is_asset = false %}
{% unless cv_img_gold_pair %}
  {% assign cv_img_gold_pair = 'elsora-ref-gold-pair-transparent-v3.png' | asset_url %}
  {% assign cv_img_gold_pair_is_asset = true %}
{% endunless %}

