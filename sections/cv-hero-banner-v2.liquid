{% assign product = product | default: all_products[section.settings.product] %}

<section class="cv-v2">
  <div class="cv-v2__gallery">

    {% if product %}

      <div class="cv-v2__main">
        {% assign first_media = product.media.first %}

        {% if first_media.media_type == 'image' %}
          {{ first_media | image_url: width: 1200 | image_tag:
            class: 'cv-v2-main-image',
            loading: 'eager'
          }}
        {% elsif first_media.media_type == 'video' %}
          {{
            first_media
            | video_tag:
              controls: true,
              autoplay: false,
              loop: false,
              class: 'cv-v2-main-video'
          }}
        {% endif %}
      </div>

      <div class="cv-v2__thumbs">

        {% for media in product.media limit: 6 %}

          {% if media.media_type == 'image' %}

            <img
              src="{{ media | image_url: width: 120 }}"
              data-full="{{ media | image_url: width: 1200 }}"
              class="cv-v2-thumb"
              loading="lazy"
            >

          {% elsif media.media_type == 'video' %}

            <div
              class="cv-v2-thumb cv-v2-video"
              data-video="{{ media.sources[0].url }}"
            >
              ▶
            </div>

          {% endif %}

        {% endfor %}

      </div>

    {% endif %}

  </div>
</section>

{% schema %}
{
  "name":"CV Hero Banner V2",
  "settings":[
    {
      "type":"product",
      "id":"product",
      "label":"Product"
    }
  ],
  "presets":[
    {
      "name":"CV Hero Banner V2"
    }
  ]
}
{% endschema %}