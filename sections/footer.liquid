{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{%- comment -%}
  ELSORA footer on EVERY page of this theme (the old lavender/purple footer
  is no longer used). It is the same footer as on the PDRN sandbox page:
  white -> teal gradient with the wave ribbons. Pages that do not use the
  ice-globes palette get the same footer colors and ELSORA typography through
  the footer-local values in the style block below.
{%- endcomment -%}
{%- assign is_pdrn_sandbox = false -%}
{%- if template.suffix == 'pdrn-sandbox' or template.suffix == 'ice-globes' or template.name == 'index' -%}
  {%- assign is_pdrn_sandbox = true -%}
{%- endif -%}
{%- assign elsora_footer = true -%}
{{ 'section-footer.css' | asset_url | stylesheet_tag }}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'component-list-menu.css' | asset_url | stylesheet_tag }}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .footer {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .footer {
      margin-top: {{ section.settings.margin_top }}px;
    }

    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  
{%- endstyle -%}
<style>
.footer {
  position: relative;
  overflow: hidden;
  background: linear-gradient(
    180deg,
    var(--elsora-footer-grad-1, #eadcff) 0%,
    var(--elsora-footer-grad-2, #c9a0ff) 45%,
    var(--elsora-footer-grad-3, #8b4dff) 100%
  );
}

.footer::before {
  content: "";
  position: absolute;
  bottom: 180px;
  left: -10%;
  width: 120%;
  height: 160px;
  background: var(--elsora-footer-accent, #a66cff);
  clip-path: ellipse(75% 55% at 50% 100%);
  z-index: 0;
}
}

.footer > * {
  position: relative;
  z-index: 1;
}

{%- if elsora_footer -%}
footer.footer {
  --elsora-footer-grad-1: #FAFCFC;
  --elsora-footer-grad-2: #35B9C5;
  --elsora-footer-grad-3: #168F9B;
  --elsora-footer-accent: #20AEBB;
  --font-body-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  --font-body-style: normal;
  --font-body-weight: 300;
  --font-body-weight-bold: 500;
  --font-heading-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  --font-heading-style: normal;
  --font-heading-weight: 500;
  --color-foreground: 13,13,13;
  font-family: var(--font-body-family);
  font-style: var(--font-body-style);
  font-weight: var(--font-body-weight);
}
footer.footer .footer-block__newsletter .footer-block__heading {
  text-shadow: var(--elsora-text-shadow-3d-footer);
}
.footer {
  border-top: none;
  background: linear-gradient(
    180deg,
    #FFFFFF 0%,
    var(--elsora-footer-grad-2, #35B9C5) 45%,
    var(--elsora-footer-grad-3, #168F9B) 100%
  );
}
.footer > .cv-footer-wave-wrap-{{ section.id }} {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 100vw;
  height: 100%;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
  mask-image: linear-gradient(180deg, black 0%, black 75%, transparent 100%);
  -webkit-mask-image: linear-gradient(180deg, black 0%, black 75%, transparent 100%);
}
.cv-footer-wave-lines--desktop-{{ section.id }},
.cv-footer-wave-lines--mobile-{{ section.id }} {
  width: 100%;
  height: 100%;
  display: none;
}
.cv-footer-wave-lines--desktop-{{ section.id }} {
  display: block;
}
@media (max-width: 900px) {
  .cv-footer-wave-lines--desktop-{{ section.id }} {
    display: none;
  }
  .cv-footer-wave-lines--mobile-{{ section.id }} {
    display: block;
  }
}
{%- endif -%}
</style>
