{% assign sid = section.id %}
{% assign product = section.settings.product | default: product %}
{% assign cv_final_variant = product.selected_or_first_available_variant %}
{% for v in product.variants %}{% if v.id == 59209490268485 %}{% assign cv_final_variant = v %}{% endif %}{% endfor %}

<div class="cv-final-{{ sid }}">
  
  <h2>{{ section.settings.headline }}</h2>

  {% if product %}
    {% form 'product', product, class: 'cv-final-form' %}
      <input type="hidden" name="id" id="final-cta-variant-id-{{ sid }}" value="{{ cv_final_variant.id }}">
      <input type="hidden" name="quantity" id="final-cta-quantity-{{ sid }}" value="1">
      <button type="submit" class="cv-cta-btn-{{ sid }}" {% if cv_final_variant.available == false %}disabled{% endif %}>
        {% if cv_final_variant.available %}
          GET YOUR PAIR — <span data-cv-final-price>{{ cv_final_variant.price | money }}</span>
        {% else %}
          Sold Out
        {% endif %}
      </button>
    {% endform %}
    {%- comment -%} ELSORA risk-reversal line directly under the final CTA button. {%- endcomment -%}
    <p class="cv-risk-line-{{ sid }}"><span>Free storage case</span><span class="cv-risk-line__dot-{{ sid }}" aria-hidden="true">&middot;</span><span>Free U.S. shipping</span><span class="cv-risk-line__dot-{{ sid }}" aria-hidden="true">&middot;</span><span>30-day money-back guarantee</span></p>
  {% elsif section.settings.fallback_link != blank %}
    <a href="{{ section.settings.fallback_link }}" class="cv-cta-btn-{{ sid }}">{{ section.settings.fallback_cta_text | default: 'Shop Now' }}</a>
  {% endif %}
  <script>
document.addEventListener('DOMContentLoaded', function() {
  const finalVariantInput = document.querySelector('#final-cta-variant-id-{{ sid }}');
  const finalQtyInput = document.querySelector('#final-cta-quantity-{{ sid }}');
  const finalPriceEl = document.querySelector('[data-cv-final-price]');

  function syncFinalCta(option) {
    var variantId = option.getAttribute('data-variant-id');
    var qty = option.getAttribute('data-qty') || '1';
    var price = option.getAttribute('data-cta-price') || option.getAttribute('data-price');
    if (finalVariantInput && variantId) finalVariantInput.value = variantId;
    if (finalQtyInput) finalQtyInput.value = qty;
    if (finalPriceEl && price) finalPriceEl.textContent = price;
  }

  document.querySelectorAll('[data-variant-id]').forEach(function(option){
    option.addEventListener('click', function(){
      syncFinalCta(option);
    });
  });

  var initialActive = document.querySelector('[data-cv-color-offer-option][aria-pressed="true"], [data-cv-bundle-option][aria-pressed="true"]');
  if (initialActive) syncFinalCta(initialActive);
});
</script>
</div>

{% style %}
  .cv-final-{{ sid }} {
  --cv-cream: var(--elsora-surface-white);
    --cv-plum: var(--elsora-plum);
    --cv-rose: var(--elsora-rose);
    --cv-radius: var(--elsora-radius);

 background:
{% if section.settings.image != blank %}
url('{{ section.settings.image | image_url: width: 2000 }}');
{% else %}
var(--elsora-finish-flat, none), var(--cv-cream);
{% endif %}
background-size: cover;
background-position: center 15%;
background-repeat: no-repeat;
{% if section.settings.image == blank %}
background-size: var(--elsora-finish-flat-size, auto);
background-repeat: var(--elsora-finish-flat-repeat, repeat);
background-blend-mode: var(--elsora-finish-flat-blend, normal);
{% endif %}
    color: var(--cv-cream);
  padding: 64px 32px;
    text-align: center;
    font-family: var(--elsora-font-body);
    box-sizing: border-box;
  }
  .cv-final-{{ sid }} *, .cv-final-{{ sid }} *::before, .cv-final-{{ sid }} *::after { box-sizing: border-box; }

  @media (max-width: 760px) { .cv-final-{{ sid }} { padding: 48px 20px; } }

  .cv-mist-{{ sid }} { display: flex; gap: 6px; align-items: center; justify-content: center; margin-bottom: 22px; }
  .cv-mist-{{ sid }} span { width: 4px; height: 4px; border-radius: 50%; background: var(--cv-rose); opacity: .55; }
  .cv-mist-{{ sid }} span:nth-child(2n) { opacity: .3; }
  .cv-mist-{{ sid }} span:nth-child(3n) { opacity: .8; }

  .cv-final-{{ sid }} h2 {
    font-family: var(--elsora-font-display);
    font-style: normal;
    font-weight: 500;
    font-size: clamp(28px, 3.6vw, 44px);
    margin: 0 0 30px;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.3;
  color: var(--elsora-cta);
  }
  .cv-final-form { max-width: 320px; margin: 0 auto; }

  .cv-cta-btn-{{ sid }} {
    display: block; width: 100%; max-width: 320px; margin: 0 auto;
    text-align: center;
   background: var(--elsora-cta);
    padding: 18px 24px; font-size: 14.5px; letter-spacing: .08em;
    text-transform: uppercase; border: none; cursor: pointer;
    border-radius: var(--cv-radius); transition: background .25s ease, color .25s ease;
    font-family: var(--elsora-font-body); font-weight: 400; text-decoration: none;
  }
 
  .cv-cta-btn-{{ sid }}[disabled] { opacity: .5; cursor: not-allowed; }

  .cv-risk-line-{{ sid }} {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 2px 8px;
    max-width: 360px; margin: 12px auto 0; text-align: center;
    font-family: var(--elsora-font-body); font-size: 12.5px; font-weight: 400;
    letter-spacing: .02em; line-height: 1.5; color: var(--elsora-plum-soft);
  }
  .cv-risk-line__dot-{{ sid }} { color: var(--elsora-cta); }
  @media (max-width: 749px) { .cv-risk-line-{{ sid }} { font-size: 12px; gap: 2px 6px; } }
{% endstyle %}

{% schema %}
{
  "name": "CV Final CTA",
  "settings": [
    { "type": "textarea", "id": "headline", "label": "Headline", "default": "Your skin deserves a routine that doesn't fight back." },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "fallback_cta_text", "label": "Fallback button text (used only if no product selected)", "default": "Shop Now" },
    { "type": "url", "id": "fallback_link", "label": "Fallback button link (used only if no product selected)" }
  ],
  "presets": [{ "name": "CV Final CTA" }]
}
{% endschema %}
